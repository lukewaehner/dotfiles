<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ~/Library/LaunchAgents/com.user.dark-notify.plist

  Install:
    launchctl load ~/Library/LaunchAgents/com.user.dark-notify.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.user.dark-notify.plist

  Requires: brew install dark-notify
  dark-notify path below assumes default Homebrew prefix.
  If on Apple Silicon and Homebrew is at /opt/homebrew, adjust accordingly.
  Check with: which dark-notify
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.dark-notify</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Update this path if `which dark-notify` differs -->
    <string>/opt/homebrew/bin/dark-notify</string>
    <string>-c</string>
    <string>$HOME/.local/bin/theme-switch.sh $APPEARANCE</string>
  </array>

  <!-- dark-notify sets $APPEARANCE to "dark" or "light" in the callback -->

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardErrorPath</key>
  <string>/tmp/dark-notify.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Ensure PATH includes Homebrew so tmux/nvim are found in the callback -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/lukewaehner</string>
  </dict>
</dict>
</plist>

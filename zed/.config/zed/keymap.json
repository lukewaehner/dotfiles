// Zed keymap — Sin-cy's setup, rebound to my LazyVim/tmux muscle memory.
// Default keymap: `zed: open default keymap` from the command palette.
[
	// Normal + visual mode (and empty panes) — <leader> = space, as in LazyVim
	{
		"context": "VimControl && !menu || EmptyPane",
		"bindings": {
			// find / search
			"space space": "file_finder::Toggle",
			"space f f": "file_finder::Toggle",
			"space f p": "projects::OpenRecent",
			"space ,": "tab_switcher::Toggle",
			"space /": "pane::DeploySearch",
			"space s g": "pane::DeploySearch",
			"space S": ["pane::DeploySearch", { "replace_enabled": true }],
			"space s s": "outline::Toggle",
			// explorer / docks
			"space e": "workspace::ToggleRightDock",
			"space t f": "terminal_panel::ToggleFocus",
			"space g g": "git_panel::ToggleFocus",
			// windows (tmux: prefix \ , prefix -, prefix z)
			"space |": "pane::SplitRight",
			"space -": "pane::SplitDown",
			"space w m": "workspace::ToggleZoom",
			"space b d": "pane::CloseActiveItem",
			// ui toggles
			"space u h": "editor::ToggleInlayHints",
			"space u z": "workspace::ToggleCenteredLayout"
		}
	},
	{
		"context": "Editor && VimControl && !VimWaiting && !menu",
		"bindings": {
			// code
			"space c a": "editor::ToggleCodeActions",
			"space c r": "editor::Rename",
			"space c f": "editor::Format",
			"space c p": "markdown::OpenPreviewToTheSide",
			"space c d": "diagnostics::Deploy",
			"g r": "editor::FindAllReferences",
			"g v": "editor::GoToDefinitionSplit",
			"] d": "editor::GoToDiagnostic",
			"[ d": "editor::GoToPreviousDiagnostic",
			// git hunks (gitsigns: <leader>h*)
			"] h": "editor::GoToHunk",
			"[ h": "editor::GoToPreviousHunk",
			"space h p": "editor::ToggleSelectedDiffHunks",
			"space h r": "git::Restore",
			"space h s": "git::ToggleStaged",
			"space h b": "git::Blame",
			// buffers (LazyVim H / L)
			"shift-h": "pane::ActivatePreviousItem",
			"shift-l": "pane::ActivateNextItem",
			// move lines (LazyVim alt-j / alt-k)
			"alt-j": "editor::MoveLineDown",
			"alt-k": "editor::MoveLineUp"
		}
	},
	{
		"context": "Editor && vim_mode == normal && !VimWaiting && !menu",
		"bindings": {
			"shift-k": "editor::Hover",
			"ctrl-6": "pane::AlternateFile"
		}
	},
	{
		"context": "Editor && vim_mode == insert && !menu",
		"bindings": {
			"ctrl-h": "editor::ShowSignatureHelp"
		}
	},
	// ctrl-hjkl between panes everywhere (vim-tmux-navigator)
	{
		"context": "Editor && vim_mode == normal && !menu || ProjectPanel && not_editing || Terminal || GitPanel",
		"bindings": {
			"ctrl-h": "workspace::ActivatePaneLeft",
			"ctrl-l": "workspace::ActivatePaneRight",
			"ctrl-k": "workspace::ActivatePaneUp",
			"ctrl-j": "workspace::ActivatePaneDown"
		}
	},
	{
		"context": "Editor",
		"bindings": {
			"ctrl-c": ["workspace::SendKeystrokes", "escape"],
			"ctrl-j": "menu::SelectNext",
			"ctrl-k": "menu::SelectPrevious"
		}
	},
	{
		"context": "Editor && showing_completions",
		"bindings": {
			"ctrl-y": "editor::ConfirmCompletion"
		}
	},
	// File explorer — neo-tree style
	{
		"context": "ProjectPanel && not_editing",
		"bindings": {
			"a": "project_panel::NewFile",
			"A": "project_panel::NewDirectory",
			"r": "project_panel::Rename",
			"d": "project_panel::Delete",
			"x": "project_panel::Cut",
			"c": "project_panel::Copy",
			"p": "project_panel::Paste",
			"q": "workspace::ToggleRightDock",
			"space e": "workspace::ToggleRightDock"
		}
	}
]
